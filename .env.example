# Use separate database roles: the runtime role must not own tables or bypass RLS.
DATABASE_URL=postgresql://nexora_app:replace-me@localhost:5432/nexora
MIGRATOR_DATABASE_URL=postgresql://nexora_migrator:replace-me@localhost:5432/nexora
# Disposable database for integration tests; never point this at a production database.
NEXORA_TEST_DATABASE_URL=postgresql://nexora_app:replace-me@localhost:5432/nexora_test
NEXORA_TEST_MIGRATOR_DATABASE_URL=postgresql://nexora_migrator:replace-me@localhost:5432/nexora_test

# Canonical browser origin used for mutation-origin checks and email links.
APP_ORIGIN=http://localhost:3000

# Replace with a random secret of at least 32 bytes; never expose it to the browser.
AUTH_RATE_LIMIT_HMAC_KEY=replace-this-with-at-least-32-random-bytes

# In production, configure a header overwritten by your trusted ingress with one client IP.
# Leave blank for local development. Do not trust a client-supplied forwarding chain.
NEXORA_TRUSTED_CLIENT_IP_HEADER=

# Server-only private file storage and five-minute signed download links.
# Use an absolute, private, persistent directory in deployments; never put it under public/.
NEXORA_PRIVATE_FILE_DIR=.private-files
NEXORA_FILE_SIGNING_KEY=replace-with-at-least-32-random-bytes

# Storage provider: "local" (default) or "s3" for an S3-compatible store.
# S3 is implemented but NOT live-verified against a real endpoint; selecting
# "s3" without all four S3 variables below fails closed, it never silently
# falls back to local. Switching providers in production requires a
# copy-then-verify migration (see docs/deployment.md), not just this flag.
NEXORA_STORAGE_PROVIDER=local
NEXORA_S3_ENDPOINT=
NEXORA_S3_BUCKET=
NEXORA_S3_REGION=us-east-1
NEXORA_S3_ACCESS_KEY=
NEXORA_S3_SECRET_KEY=
# "true" (default) for path-style (bucket in the path, needed for MinIO and
# most S3-compatible stores); "false" for virtual-host style.
NEXORA_S3_FORCE_PATH_STYLE=true

# Malware scanning (ClamAV daemon, INSTREAM protocol, no SDK).
# Unset (default) means no scanner: uploads are recorded as scan_status
# 'pending' (not scanned, never clean) and malware protection is NOT
# operational. Set to "clamav" to scan synchronously at upload: clean
# files are 'clean', infected files and scanner failures are
# 'quarantined' (bytes kept, downloads blocked with 409
# FILE_QUARANTINED). Rescan pending/quarantined files with
# scripts/rescan-task-files.mjs once a scanner is configured.
NEXORA_MALWARE_SCANNER=
NEXORA_CLAMAV_HOST=127.0.0.1
NEXORA_CLAMAV_PORT=3310

# Google OAuth was removed 2026-10-26 (user decision: email +
# password only, migration 0047). No OAuth variables are read
# anymore; do not set OAUTH_GOOGLE_* or OAUTH_FLOW_SIGNING_KEY.

# Operator metrics token for GET /api/metrics. Blank (or unset) means
# the metrics endpoint fails closed with 503. Set to a long random
# value; scrapers send it as the x-nexora-metrics-token header.
NEXORA_METRICS_TOKEN=

# AI provider configuration. AI_PROVIDER=missing (or anything else)
# means AI endpoints fail closed with 503 AI_UNAVAILABLE; nothing is
# fabricated. AI_PROVIDER=mock is a deterministic test double, refused
# in production. AI_PROVIDER=http uses a generic OpenAI-compatible
# chat-completions endpoint; the key is server-only and never logged.
AI_PROVIDER=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Notification email (approved default, 2026-10-26). Empty means
# disabled: no notification is emailed by default. List event types
# (mention, task_assigned, project_activity, due_date, ai_workflow)
# only for types the operator wants emailed, and only recipients
# who enabled email for that type in their preferences receive one.
# Delivery is via the transactional outbox + worker
# (npm run notifications:email-worker, e.g. every minute); the
# worker fails closed when SMTP is unconfigured and leaves rows
# pending. Never send every notification by default.
NEXORA_NOTIFICATION_EMAIL_TYPES=

# SMTP settings for verification and password-recovery links.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.test
